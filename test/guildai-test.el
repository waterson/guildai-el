;;; guildai-test.el --- Guild client tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'guildai)

(ert-deftest guildai-renders-multipart-and-deduplicates ()
  (with-temp-buffer
    (guildai-session-mode)
    (let ((events '(((id . "one") (type . "agent_notification_message")
                     (content . ((type . "multipart/mixed")
                                 (parts . (((type . "text") (data . "Hello"))
                                           ((type . "text") (data . "World"))))))))))
      (guildai--events events)
      (guildai--events events)
      (should (equal (buffer-string) "agent_notification_message\nHello\nWorld\n\n"))
      (should (equal guildai--cursor "one")))))

(ert-deftest guildai-fetches-every-page ()
  (let (paths result)
    (cl-letf (((symbol-function 'guildai--request)
               (lambda (_method path _body success _failure)
                 (push path paths)
                 (funcall success
                          (if (= (length paths) 1)
                              '((items . (a)) (pagination . ((has_more . t) (limit . 2))))
                            '((items . (b)) (pagination . ((has_more . nil)))))))))
      (guildai--all "/things?filter=all" (lambda (items) (setq result items)))
      (should (equal result '(a b)))
      (should (equal (reverse paths)
                     '("/things?filter=all&limit=100&offset=0"
                       "/things?filter=all&limit=100&offset=2"))))))

(ert-deftest guildai-invalid-pagination-surfaces-error ()
  (let (problem)
    (cl-letf (((symbol-function 'guildai--request)
               (lambda (_m _p _b success _failure)
                 (funcall success '((pagination . ((has_more . t) (limit . 0))))))))
      (guildai--all "/things" #'ignore (lambda (value) (setq problem value)))
      (should (string-match-p "pagination" problem)))))

(ert-deftest guildai-failed-send-preserves-draft ()
  (with-temp-buffer
    (guildai-compose-mode)
    (setq guildai--workspace-id "workspace")
    (insert "Please help")
    (cl-letf (((symbol-function 'guildai--request)
               (lambda (_m _p _b _s failure) (funcall failure "HTTP 403"))))
      (guildai-send))
    (should (equal (buffer-string) "Please help"))
    (should-not buffer-read-only)
    (should-not guildai--sending)))

(ert-deftest guildai-does-not-send-a-draft-twice ()
  (with-temp-buffer
    (guildai-compose-mode)
    (setq guildai--workspace-id "workspace")
    (insert "Please help")
    (let ((requests 0))
      (cl-letf (((symbol-function 'guildai--request)
                 (lambda (&rest _) (cl-incf requests))))
        (guildai-send)
        (should-error (guildai-send) :type 'user-error))
      (should (= requests 1)))))

(ert-deftest guildai-new-session-sends-agent-and-prompt ()
  (with-temp-buffer
    (guildai-compose-mode)
    (setq guildai--workspace-id "owner~workspace")
    (insert "Explain this")
    (let ((guildai-agent "owner~agent") path body)
      (cl-letf (((symbol-function 'guildai--request)
                 (lambda (_m p b _s _f) (setq path p body b))))
        (guildai-send))
      (should (equal path "/workspaces/owner~workspace/sessions"))
      (should (equal (alist-get 'initial_prompt body) "Explain this"))
      (should (equal (alist-get 'agent_id body) "owner~agent")))))

(ert-deftest guildai-followup-sends-text-event ()
  (with-temp-buffer
    (guildai-compose-mode)
    (setq guildai--target "session" guildai--workspace-id "workspace")
    (insert "Continue")
    (let (path body)
      (cl-letf (((symbol-function 'guildai--request)
                 (lambda (_m p b _s _f) (setq path p body b))))
        (guildai-send))
      (should (equal path "/sessions/session/events"))
      (should (equal body '((content . "Continue") (mode . "text")))))))

(ert-deftest guildai-request-parses-json-and-cleans-up ()
  (let ((guildai-credential-function (lambda () "key:secret"))
        response-buffer result)
    (cl-letf (((symbol-function 'url-retrieve)
               (lambda (_url callback &rest _)
                 (should (equal (cdr (assoc "Authorization" url-request-extra-headers))
                                "Bearer key:secret"))
                 (should (= url-max-redirections 0))
                 (setq response-buffer (generate-new-buffer " *guildai-test-response*"))
                 (with-current-buffer response-buffer
                   (insert "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{\"id\":\"session\"}")
                   (setq-local url-http-response-status 200)
                   (funcall callback nil)))))
      (guildai--request "GET" "/sessions/session" nil
                        (lambda (value) (setq result value)) #'ert-fail))
    (should (equal (alist-get 'id result) "session"))
    (should-not (buffer-live-p response-buffer))))

(ert-deftest guildai-request-surfaces-http-error ()
  (let ((guildai-credential-function (lambda () "key:secret")) problem)
    (cl-letf (((symbol-function 'url-retrieve)
               (lambda (_url callback &rest _)
                 (with-current-buffer (generate-new-buffer " *guildai-error*")
                   (insert "HTTP/1.1 403 Forbidden\r\n\r\n{}")
                   (setq-local url-http-response-status 403)
                   (funcall callback '(:error (error http 403)))))))
      (guildai--request "GET" "/things" nil #'ert-fail
                        (lambda (value) (setq problem value))))
    (should (string-match-p "403" problem))))

(ert-deftest guildai-refresh-resumes-and-stops-on-error ()
  (with-temp-buffer
    (guildai-session-mode)
    (setq guildai--session-id "session" guildai--cursor "last")
    (let (path)
      (cl-letf (((symbol-function 'guildai--all)
                 (lambda (p _success failure &rest _)
                   (setq path p)
                   (funcall failure "Network unavailable"))))
        (guildai-refresh))
      (should (string-match-p "from_id=last" path))
      (should (string-match-p "Network unavailable" (buffer-string)))
      (should-not guildai--busy)
      (should-not guildai--timer))))

(ert-deftest guildai-killing-session-cancels-polling ()
  (let ((buffer (generate-new-buffer " *guildai-timer*")) timer)
    (with-current-buffer buffer
      (guildai-session-mode)
      (setq timer (run-at-time 100 nil #'ignore) guildai--timer timer))
    (kill-buffer buffer)
    (should-not (memq timer timer-list))))

(ert-deftest guildai-region-is-reviewed-before-any-request ()
  (let (draft)
    (with-temp-buffer
      (insert "Selected text")
      (let ((guildai-workspace "workspace"))
        (cl-letf (((symbol-function 'pop-to-buffer)
                   (lambda (buffer &rest _) (setq draft buffer)))
                  ((symbol-function 'guildai--request)
                   (lambda (&rest _) (ert-fail "Unexpected network request"))))
          (guildai-send-region (point-min) (point-max)))))
    (unwind-protect
        (with-current-buffer draft
          (should (string-match-p "Selected text" (buffer-string)))
          (should (derived-mode-p 'guildai-compose-mode)))
      (with-current-buffer draft (set-buffer-modified-p nil))
      (kill-buffer draft))))
